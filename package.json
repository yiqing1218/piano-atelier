{
  "name": "piano-atelier",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run prepare:audio",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "npm run prepare:audio && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "prepare:synth": "node scripts/copy-synth-processor.mjs",
    "prepare:piano": "node scripts/prepare-piano-samples.mjs",
    "prepare:audio": "npm run prepare:synth && npm run prepare:piano && npm run prepare:instruments",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "prepare:instruments": "node scripts/prepare-instruments.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tonejs/midi": "^2.0.28",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "spessasynth_core": "4.3.22",
    "spessasynth_lib": "^4.3.0"
  },
  "devDependencies": {
    "@audio-samples/piano-velocity12": "1.0.5",
    "@audio-samples/piano-velocity16": "1.0.5",
    "@audio-samples/piano-velocity4": "1.0.5",
    "@audio-samples/piano-velocity8": "1.0.5",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@wasm-audio-decoders/flac": "0.2.11",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.12"
  }
}
